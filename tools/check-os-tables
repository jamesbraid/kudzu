#!/bin/sh
# Check that evidence/inventory/ and the kernel-table block of evidence/coverage.md are what
# retools/tools/kudzu/os_tables.py generates now. They go stale when a documentation page changes (the
# status columns read the pages) or tools/config/scope.json does; regenerate with
#
#   retools/tools/re-run python3 retools/tools/inventory.py
#   retools/tools/re-run python3 retools/tools/kudzu/os_tables.py
#
# Needs root/ populated. Takes about a minute.
set -eu
cd "$(dirname "$0")/.."
exec retools/tools/re-run python3 retools/tools/kudzu/os_tables.py --check
